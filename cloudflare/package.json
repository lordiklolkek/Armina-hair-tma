{
  "name": "barbershop-37",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && wrangler dev --local --port 8787",
    "check": "tsc --noEmit",
    "test": "node scripts/prepare-assets.mjs && tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:local": "wrangler d1 migrations apply barbershop-37-demo --local",
    "seed:local": "wrangler d1 execute barbershop-37-demo --local --file seeds/demo.sql",
    "build": "node scripts/prepare-assets.mjs && wrangler deploy --dry-run --outdir dist",
    "deploy": "node scripts/prepare-assets.mjs && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "qrcode-generator": "1.4.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@types/node": "^24.0.0",
    "jsqr": "1.4.0",
    "miniflare": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.150.0"
  }
}
