{
  "name": "barbershop-37", "private": true, "type": "module", "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "check": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:local": "wrangler d1 migrations apply barbershop-37-demo --local",
    "seed:local": "wrangler d1 execute barbershop-37-demo --local --file seeds/demo.sql",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {"hono": "^4.0.0", "zod": "^4.0.0"},
  "devDependencies": {"typescript": "^5.0.0", "@cloudflare/workers-types": "^4.0.0", "@types/node": "^24.0.0", "tsx": "^4.0.0", "wrangler": "^4.0.0", "miniflare": "^4.0.0"}
}
