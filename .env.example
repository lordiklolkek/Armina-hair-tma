# Create via @BotFather. NEVER upload a real .env to GitHub.
BOT_TOKEN=
BOT_USERNAME=ArminaHair_Bot

# Group chat ID (-100...), channel ID, or a private administrator's numeric Telegram ID.
ADMIN_CHAT_ID=
# Optional explicit whitelisted admins, comma-separated. Group/channel admins are also recognized.
ADMIN_USER_IDS=

# Public HTTPS origin WITHOUT trailing slash (empty for local browser preview).
# On Render the app automatically uses RENDER_EXTERNAL_URL if this is empty.
# Automatic webhook/menu/commands registration is disabled by default.
# Keep false on the old Render service throughout the Cloudflare migration.
TELEGRAM_AUTO_CONFIGURE=false
PUBLIC_BASE_URL=
WEBHOOK_SECRET=
# Render's blueprint generates WEBHOOK_SECRET_SEED; the app hashes it to a
# Telegram-compatible secret. An explicit WEBHOOK_SECRET takes precedence.
WEBHOOK_SECRET_SEED=

SALON_NAME=Armina Hair
SALON_ADDRESS=Демо-салон (укажите реальный адрес перед запуском)
DATABASE_URL=sqlite+aiosqlite:///./salon.db
